kate: tab-width 4; indent-width 4; replace-tabs on;

# https://docs.kde.org/trunk_kf6/en/kate/katepart/config-variables.html
# https://kate-editor.org/syntax/

# 1. JavaScript / TypeScript
kate-wildcard(*.js): runner '%{Project:Path}/languages/javascript-or-typescript/runner.sh'; hl 'JavaScript';

# 2. Python
kate-wildcard(*.py): runner '%{Project:Path}/languages/python/runner.sh'; hl 'Python';

# 3. PHP
kate-wildcard(*.php): runner '%{Project:Path}/languages/php/runner.sh'; hl 'PHP/PHP';

# 4. Go
kate-wildcard(*.go): runner '%{Project:Path}/languages/go/runner.sh'; hl 'Go';

# 5. Perl
kate-wildcard(*.pl): runner '%{Project:Path}/languages/perl/runner.sh'; hl 'Perl';

# 6. Julia
kate-wildcard(*.jl): runner '%{Project:Path}/languages/julia/runner.sh'; hl 'Julia';

# 7. Lua
kate-wildcard(*.lua): runner '%{Project:Path}/languages/lua/runner.sh'; hl 'Lua';

# 8. Ruby
kate-wildcard(*.rb): runner '%{Project:Path}/languages/ruby/runner.sh'; hl 'Ruby';

# 9. R
kate-wildcard(*.r): runner '%{Project:Path}/languages/r/runner.sh'; hl 'R Script';

# 10. Kotlin
kate-wildcard(*.kt): runner '%{Project:Path}/languages/kotlin/runner.sh'; hl 'Kotlin';

# 11. Swift
kate-wildcard(*.swift): runner '%{Project:Path}/languages/swift/runner.sh'; hl 'Swift';

# 12. Dart
kate-wildcard(*.dart): runner '%{Project:Path}/languages/dart/runner.sh'; hl 'Dart';

# 13. VB.NET (Visual Basic dotNET)
kate-wildcard(*.vb): runner '%{Project:Path}/languages/visual-basic-dot-net/runner.sh'; hl 'MonoBasic';

# 14. C# (C Sharp)
kate-wildcard(*.cs): runner '%{Project:Path}/languages/c-sharp/runner.sh'; hl 'C#';

# 15. MATLAB / Octave
kate-wildcard(*.m): runner '%{Project:Path}/languages/objective-c/runner.sh'; hl 'Objective-C';

# 16. Wolfram Language (Mathematica)
kate-wildcard(*.wl): runner '%{Project:Path}/languages/wolfram-language-mathematica/runner.sh'; hl 'Mathematica';

# 17. Raku
kate-wildcard(*.raku): runner '%{Project:Path}/languages/raku/runner.sh'; hl 'Raku';

# 18. Scala
kate-wildcard(*.scala): runner '%{Project:Path}/languages/scala/runner.sh'; hl 'Scala';

# 19. Java
kate-wildcard(*.java): runner '%{Project:Path}/languages/java/runner.sh'; hl 'Java';

# 20. Nu
kate-wildcard(*.nu): runner '%{Project:Path}/languages/nu/runner.sh'; hl 'Julia';

# 21. Elvish
kate-wildcard(*.elv): runner '%{Project:Path}/languages/elvish/runner.sh'; hl 'Elvish';

# 22. Vim Script
kate-wildcard(*.vim): runner '%{Project:Path}/languages/vim-script/runner.sh'; hl 'C#';

# 23. Rust
kate-wildcard(*.rs): runner '%{Project:Path}/languages/rust/runner.sh'; hl 'Rust';

# 24. Nix
kate-wildcard(*.nix): runner '%{Project:Path}/languages/nix/runner.sh'; hl 'Nix';

# 25. Tcl
kate-wildcard(*.tcl): runner '%{Project:Path}/languages/tcl/runner.sh'; hl 'Tcl/Tk';

# 26. GDScript
kate-wildcard(*.gd): runner '%{Project:Path}/languages/gdscript/runner.sh'; hl 'Godot';

# 27. Typst
kate-wildcard(*.typ): runner '%{Project:Path}/languages/typst/runner.sh'; hl 'Typst';

# 28. PowerShell
kate-wildcard(*.ps1): runner '%{Project:Path}/languages/powershell/runner.sh'; hl 'PowerShell';

# 29. Elixir
kate-wildcard(*.exs): runner '%{Project:Path}/languages/elixir/runner.sh'; hl 'Elixir';

# 30. OCaml
kate-wildcard(*.ml): runner '%{Project:Path}/languages/ocaml/runner.sh'; hl 'Objective Caml';

# 31. Erlang
kate-wildcard(*.erl): runner '%{Project:Path}/languages/erlang/runner.sh'; hl 'Erlang';

# 32. Gleam
kate-wildcard(*.gleam): runner '%{Project:Path}/languages/gleam/runner.sh'; hl 'Gleam';

# 33. Zig
kate-wildcard(*.zig): runner '%{Project:Path}/languages/zig/runner.sh'; hl 'Zig';

# 34. Nim
kate-wildcard(*.nim): runner '%{Project:Path}/languages/nim/runner.sh'; hl 'Nim';

# 35. Odin
kate-wildcard(*.odin): runner '%{Project:Path}/languages/odin/runner.sh'; hl 'Odin';

# 36. C++ (C Plus Plus)
kate-wildcard(*.cpp): runner '%{Project:Path}/languages/c-plus-plus/runner.sh'; hl 'C++';

# 37. Objective C
kate-wildcard(*.m): runner '%{Project:Path}/languages/objective-c/runner.sh'; hl 'Objective-C';
