# 41. Cangjie
kate-wildcard(*.cj): runner '%{Project:Path}/languages/cangjie/runner.sh'; hl 'Swift';

# 42. C3
kate-wildcard(*.c3): runner '%{Project:Path}/languages/c3/runner.sh'; hl 'Rust';

# 43. C
kate-wildcard(*.c): runner '%{Project:Path}/languages/c/runner.sh'; hl 'C';

# 44. D
kate-wildcard(*.d): runner '%{Project:Path}/languages/d/runner.sh'; hl 'D';

# 45. V
kate-wildcard(*.v): runner '%{Project:Path}/languages/v/runner.sh'; hl 'V';

# 46. Vala
kate-wildcard(*.vala): runner '%{Project:Path}/languages/vala/runner.sh'; hl 'Vala';

# 47. Crystal
kate-wildcard(*.cr): runner '%{Project:Path}/languages/crystal/runner.sh'; hl 'Crystal';

# 48. Wren
kate-wildcard(*.wren): runner '%{Project:Path}/languages/wren/runner.sh'; hl 'Rust';

# 49. Pike
kate-wildcard(*.pike): runner '%{Project:Path}/languages/pike/runner.sh'; hl 'Pike';
